# Match docker-compose Endee auth (optional). If set, pass same value as ENDEE_AUTH_TOKEN to the backend.
NDD_AUTH_TOKEN=

# Backend JWT signing (change in production)
JWT_SECRET=change-me-in-production

# Flutter / clients send: Authorization: Bearer <this> (demo auth)
API_BEARER_TOKEN=demo-hr-token

# Local backend (not in Docker): point at Endee on localhost
ENDEE_BASE_URL=http://127.0.0.1:8080/api/v1
ENDEE_AUTH_TOKEN=

# Ollama (default RAG generator)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Set to 1 to use OpenAI instead of Ollama (snippets leave your VPC)
USE_CLOUD_LLM=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite path for chunk text (vectors + encrypted flow live in Endee; text vault is local DB)
DATABASE_PATH=./backend/data/app.db
