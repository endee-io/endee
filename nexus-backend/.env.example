# Environment Configuration for Nexus Backend

# Endee Vector Database
ENDEE_URL=http://localhost:3001
ENDEE_INDEX=nexus_knowledge

# API Configuration
PORT=8000
HOST=0.0.0.0

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=10

# Graph Configuration
DEFAULT_SIMILARITY_THRESHOLD=0.7
MAX_GRAPH_NODES=100
MAX_EDGES_PER_NODE=5

# Development
DEBUG=true
LOG_LEVEL=INFO
