# ─────────────────────────────────────────────
#  Endee Vector Database
# ─────────────────────────────────────────────
# URL of the running Endee server (default: localhost:8080)
ENDEE_BASE_URL=http://localhost:8080/api/v1

# Auth token (only needed if NDD_AUTH_TOKEN was set when starting Endee)
ENDEE_AUTH_TOKEN=

# ─────────────────────────────────────────────
#  LLM Backend  (choose one, or leave blank to
#  use retrieval-only mode)
# ─────────────────────────────────────────────

# Option 1 – OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Option 2 – Ollama (local)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────────
#  FastAPI server
# ─────────────────────────────────────────────
PORT=8000
