.vscode/
.vscode/*

# Frontend
frontend/
frontend/*

# DS Store
.DS_Store


scripts/
scripts/*
.claude/
.claude/*

# Environment files - NEVER commit these (may contain secrets)
.env
.env.local
.env.*.local

# Keep template files in version control
!.env.example
!.env.dev
!.env.prod

