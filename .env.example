# =============================================================================
# Endee Serverless Docker Compose Environment Configuration
# =============================================================================
# This file contains all configurable values for docker-compose.yml
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update values in .env according to your environment
# 3. NEVER commit .env to version control (it's in .gitignore)
#
# SECURITY WARNING:
# - NDD_AUTH_TOKEN is MANDATORY and must be a secure random value
# - Generate with: openssl rand -hex 32
# - Keep your .env file secure and never share it
# =============================================================================

# -----------------------------------------------------------------------------
# Application Port Configuration
# -----------------------------------------------------------------------------
# Port on which the endee-serverless service will be accessible
# Format: HOST_PORT (will map to container port NDD_SERVER_PORT)
APP_PORT=8080

# -----------------------------------------------------------------------------
# Monitoring Port Configuration
# -----------------------------------------------------------------------------
# Port on which Grafana Alloy monitoring service will be accessible
ALLOY_PORT=12345

# -----------------------------------------------------------------------------
# Server Identity Configuration
# -----------------------------------------------------------------------------
# Unique identifier for this server instance
NDD_SERVER_ID=dev

# Port on which the internal server listens (should match APP_PORT)
NDD_SERVER_PORT=8080

# Server deployment type
# Options: OSS (Open Source), ON-PREM, SERVERLESS, DEV
NDD_SERVER_TYPE=DEV

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Internal container path for data storage (usually don't change this)
NDD_DATA_DIR=/data

# Host machine path for data persistence
# This is where your data will be stored on the host machine
# IMPORTANT: Change this to match your host system's mount point
# Examples:
#   - Linux: /mnt/endee-data or /home/debian/mnt
#   - macOS: /Users/Shared/endee-data
VOLUME_HOST_PATH=/home/debian/mnt

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Percentage of vectors to cache in memory (0-100)
# Higher values = better performance but more memory usage
NDD_VECTOR_CACHE_PERCENTAGE=15

# Minimum cache size in bits (2^N entries)
# Default: 17 = 131,072 entries minimum
NDD_VECTOR_CACHE_MIN_BITS=17

# -----------------------------------------------------------------------------
# Performance & Parallelism Configuration
# -----------------------------------------------------------------------------
# Number of parallel threads for insert operations
# Recommended: 4-8 for most systems
NDD_NUM_PARALLEL_INSERTS=4

# Number of threads for recovery operations
# Recommended: Match your CPU core count or use 16
NDD_NUM_RECOVERY_THREADS=16

# -----------------------------------------------------------------------------
# Debugging Configuration
# -----------------------------------------------------------------------------
# Enable detailed debug logging
# Options: "true", "1", "false", "0"
# WARNING: Debug logs can be verbose and impact performance
NDD_DEBUG_LOG=true

# -----------------------------------------------------------------------------
# Authentication Configuration (CRITICAL - REQUIRED)
# -----------------------------------------------------------------------------
# Authentication token for API access
# SECURITY WARNING: This is REQUIRED in serverless mode
# Generate a secure token with: openssl rand -hex 32
#
# Example: NDD_AUTH_TOKEN=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
NDD_AUTH_TOKEN=secure_token

# -----------------------------------------------------------------------------
# Usage Statistics & Telemetry
# -----------------------------------------------------------------------------
# Endpoint for serverless usage statistics (serverless only)
# Leave as default unless instructed otherwise
NDD_USAGE_STATS_URL=https://dapp.endee.io/users/api/v1/query-count/

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Maximum size of a single log file before rotation
# Format: <number>m for megabytes, <number>g for gigabytes
# Example: 200m = 200 megabytes
LOG_MAX_SIZE=200m

# Maximum number of rotated log files to keep
# Total log space = LOG_MAX_SIZE * LOG_MAX_FILE
# Example: 200m * 5 = 1000m (1 GB total)
LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# Grafana Alloy Monitoring Configuration
# -----------------------------------------------------------------------------
# Loki endpoint for log aggregation
# Update this with your Loki instance URL
LOKI_ENDPOINT=https://w3vwykaqgt.ap-south-1.awsapprunner.com/loki/api/v1/push

# Prometheus endpoint for metrics collection
# Update this with your Prometheus remote write URL
PROMETHEUS_ENDPOINT=https://w3vwykaqgt.ap-south-1.awsapprunner.com/prometheus/api/v1/write

# Container name pattern to filter for log collection
# Default: Only collect logs from endee-serverless container
CONTAINER_FILTER=/endee-serverless

# Environment label for metrics
# Helps identify metrics source in multi-environment deployments
METRICS_ENVIRONMENT=dev

# Namespace label for metrics organization
METRICS_NAMESPACE=endee

# -----------------------------------------------------------------------------
# Cleanup Configuration
# -----------------------------------------------------------------------------
# Directory path for storing deleted/cleanup data
# IMPORTANT: Change this to match your host system's cleanup directory
CLEANUP_DIR=/home/debian/mnt/deleted

# -----------------------------------------------------------------------------
# GCS Backup Configuration
# -----------------------------------------------------------------------------
# Google Cloud Storage bucket name for backups
NDD_GCS_BUCKET=endee-backups

# Path prefix within the GCS bucket for organizing backups
NDD_GCS_PATH_PREFIX=backups/

# GCS service account email for authentication
# Get this from your GCP service account credentials
NDD_GCS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# GCS service account private key for authentication
# SECURITY WARNING: Keep this secure, never commit to version control
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Get this from your GCP service account JSON key file
NDD_GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Enable compression for backups
# Options: "true", "1", "false", "0"
# Compressed backups save storage space but require CPU for compression
NDD_BACKUP_COMPRESSION=true

# -----------------------------------------------------------------------------
# Runtime Map Size Configuration
# -----------------------------------------------------------------------------
# These settings control the memory-mapped database sizes for various components
# Values are in bits (2^N bytes), allowing dynamic growth up to MAX values
# WARNING: Changing these values requires careful consideration of available memory
# and expected data sizes. Incorrect values may cause performance issues or OOM errors.

# Index Metadata Map Size
# Controls metadata storage for index entries
# Default: 2^21 bytes (2 MB) initial, 2^27 bytes (128 MB) maximum
NDD_INDEX_META_MAP_SIZE_BITS=21
NDD_INDEX_META_MAP_SIZE_MAX_BITS=27

# ID Mapper Map Size
# Controls internal ID to external ID mapping storage
# Default: 2^24 bytes (16 MB) initial, 2^33 bytes (8 GB) maximum
NDD_ID_MAPPER_MAP_SIZE_BITS=24
NDD_ID_MAPPER_MAP_SIZE_MAX_BITS=33

# Filter Map Size
# Controls filter/bloom filter storage for efficient lookups
# Default: 2^24 bytes (16 MB) initial, 2^36 bytes (64 GB) maximum
NDD_FILTER_MAP_SIZE_BITS=24
NDD_FILTER_MAP_SIZE_MAX_BITS=36

# Metadata Map Size
# Controls document metadata storage
# Default: 2^27 bytes (128 MB) initial, 2^39 bytes (512 GB) maximum
NDD_METADATA_MAP_SIZE_BITS=27
NDD_METADATA_MAP_SIZE_MAX_BITS=39

# Vector Map Size
# Controls dense vector embeddings storage
# Default: 2^30 bytes (1 GB) initial, 2^40 bytes (1 TB) maximum
NDD_VECTOR_MAP_SIZE_BITS=30
NDD_VECTOR_MAP_SIZE_MAX_BITS=40

# Sparse Vector Map Size
# Controls sparse vector embeddings storage maximum size
# Default: 2^40 bytes (1 TB) maximum
NDD_SPARSE_MAP_SIZE_MAX_BITS=40
